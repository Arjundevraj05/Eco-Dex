# --- Demo deployment (no database required) ---
# Set this to true when deploying for recruiters / portfolio visitors
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# --- Full mode (requires MongoDB) ---
# DEMO_MODE=false
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=EcoDex
# MONGODB_DB=ecodex
# JWT_SECRET=replace-with-a-long-random-secret
# TOKEN_SECRET=replace-with-a-long-random-secret

NEXT_PUBLIC_BASE_URL=http://localhost:3000
DOMAIN=http://localhost:3000
FLASK_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_FLASK_URL=http://localhost:5000
